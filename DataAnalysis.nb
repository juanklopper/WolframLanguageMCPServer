      RowBox[{
       RowBox[{"Sort", "[", "idCol", "]"}], "===", 
       RowBox[{"Range", "[", 
        RowBox[{"Length", "[", "idCol", "]"}], "]"}]}], ")"}]}]}], 
   "\[IndentingNewLine]", "|>"}], "]"}]}], "Input",
