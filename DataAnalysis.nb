Cell["COMPARATIVE DATA ANALYSIS", "Section",ExpressionUUID->"bdb8fde8-fe39-45fc-97c6-c4238e30e7c4"],

Cell[TextData[{
 "The response variable is ",
 Cell[BoxData[Cell["DiabetesMellitus",
   Background->None,ExpressionUUID->"25ad4960-a7e8-4232-bf19-b97f2ee40fa6"]], 
  "InlineCode",ExpressionUUID->"1372a006-2f16-4c6e-af66-ecbddd8aa420"],
 ". Every other measured column is compared side by side between subjects \
with (",
 Cell[BoxData["\"\<Y\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "f400cb07-b75c-492f-9f92-d51535d3a5e8"],
 ") and without (",
 Cell[BoxData["\"\<N\>\""], "InlineWL", "Input",
  ShowAutoStyles->True,
  ShowSyntaxStyles->True,
  LanguageCategory->"Input",
  ShowStringCharacters->True,ExpressionUUID->
  "ac3e7b43-633c-4dbc-9f16-808376799355"],
 ") diabetes mellitus. Proportions are computed within each response \
category. "
}], "Text",ExpressionUUID->"7608ad44-74df-465b-96e2-70f25ea1d50b"],

