Cell["SURVEY", "Subsection",ExpressionUUID->"0607a14e-c89d-4ade-9d8f-3cf58e39773b"],

Cell["\<\
Ordinal (5 levels), so counts, proportions, mode, and median are reported \
rather than only a mean. \
\>", "Text",ExpressionUUID->"30ef1ac3-fa77-4311-937d-620df0094a2d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"surveyCol", "=", 
   RowBox[{"Normal", "[", 
    RowBox[{"data", "[", 
     RowBox[{"All", ",", "\"\<Survey\>\""}], "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"surveyLevels", "=", 
   RowBox[{"Range", "[", "5", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"surveyDecode", "=", 
   RowBox[{"<|", 
    RowBox[{
     RowBox[{"1", "->", "\"\<Strongly Disagree\>\""}], ",", 
     RowBox[{"2", "->", "\"\<Disagree\>\""}], ",", 
     RowBox[{"3", "->", "\"\<Neither\>\""}], ",", 
     RowBox[{"4", "->", "\"\<Agree\>\""}], ",", 
     RowBox[{"5", "->", "\"\<Strongly Agree\>\""}]}], "|>"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"surveyCounts", "=", 
   RowBox[{"Counts", "[", "surveyCol", "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"KeySort", "[", "surveyCounts", "]"}]}], "Input",
 CellLabel->"In[32]:=",ExpressionUUID->"606d82ee-0271-42cd-bf28-fdfaf140cce7"],

