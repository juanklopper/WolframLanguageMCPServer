Cell[CellGroupData[{

Cell["UNIVARIATE DATA ANALYSIS", "Section",ExpressionUUID->"7511aa83-bf14-4bb4-ba05-3be09039d1ae"],

Cell["\<\
Each column is described on its own, in CSV column order, using statistics \
that match its role in the data dictionary. \
\>", "Text",ExpressionUUID->"225bb02d-ed76-4294-acb3-f83426bc45fd"],

Cell[CellGroupData[{

Cell["ID", "Subsection",ExpressionUUID->"78c37455-d796-4560-9ad5-556bd67f0613"],

Cell[TextData[{
 Cell[BoxData[Cell["ID",
   Background->None,ExpressionUUID->"cbc21375-0954-44c1-a81a-ad74ebd85d45"]], 
  "InlineCode",ExpressionUUID->"46a1740b-d5c1-4f76-a8e4-9697b7e1e56f"],
 " is an identifier, so it only receives a uniqueness and completeness check. "
}], "Text",ExpressionUUID->"4c06b331-0e04-4545-bba0-cab644481272"],

